+            var loader:Loader=key as Loader;if(loader==null)continue;
+            var domain:ApplicationDomain=loader.contentLoaderInfo.applicationDomain;
+            if(domain.hasDefinition(entry))return domain;
+         }
+         return null;
+      }
+   }
