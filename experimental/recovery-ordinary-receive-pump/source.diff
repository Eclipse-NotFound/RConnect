       private var _syncCount:int = 0;
 
+      /** Drain already available input before this tick reads room/session state. */
+      private function pollIncoming():void
+      {
+         if(mode==JOINING || mode==CONNECTED)
+         {
+            var activeLink:TcpLink=link;
+            if(activeLink!=null)activeLink.pollIncoming();
+            return;
+         }
+         if(mode!=HOSTING || server==null)return;
+         var activeServer:HostServer=server;
+         var pending:Array=activeServer.clients.concat();
+         for each(var client:TcpLink in pending)
+         {
+            if(mode!=HOSTING || server!==activeServer || !activeServer.bound)break;
+            if(activeServer.clients.indexOf(client)>=0)client.pollIncoming();
+         }
+      }
+
       private function onTick(e:TimerEvent):void
       {
+         pollIncoming();
